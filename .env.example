# Optional live LLM configuration. Never commit real values.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=

# Enable signed-session authorization for data-quality routes.
REQUIRE_AUTH=false
VANNA_AUTH_SECRET=
VANNA_ADMIN_EMAIL=admin@example.com

# Comma-separated trusted frontend origins when CORS is explicitly enabled.
VANNA_CORS_ORIGINS=
